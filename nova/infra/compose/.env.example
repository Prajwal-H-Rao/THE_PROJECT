# The local secret file of the Compose stack. Copy it to `.env` and keep that file out of git.
# The values are synthetic local defaults. A real deployment takes the values from a secrets
# manager. The compose file refuses to start when a value is missing.
NOVA_PG_SUPERUSER_PASSWORD=nova-local-superuser
NOVA_PG_PASSWORD_AGENT_ORCHESTRATOR=nova-local-agent-orchestrator
NOVA_PG_PASSWORD_AUDIT_ACTIVITY_SERVICE=nova-local-audit-activity-service
NOVA_PG_PASSWORD_CALENDAR_SERVICE=nova-local-calendar-service
NOVA_PG_PASSWORD_CHANNEL_ADAPTER_WHATSAPP=nova-local-channel-adapter-whatsapp
NOVA_PG_PASSWORD_EMPLOYER_REGISTRY_SERVICE=nova-local-employer-registry-service
NOVA_PG_PASSWORD_FINANCE_SERVICE=nova-local-finance-service
NOVA_PG_PASSWORD_IDENTITY_SERVICE=nova-local-identity-service
NOVA_PG_PASSWORD_INBOX_SERVICE=nova-local-inbox-service
NOVA_PG_PASSWORD_INTEGRATION_REGISTRY=nova-local-integration-registry
NOVA_PG_PASSWORD_JOBS_SERVICE=nova-local-jobs-service
NOVA_PG_PASSWORD_MODEL_GATEWAY=nova-local-model-gateway
NOVA_PG_PASSWORD_NOTES_MEMORY_SERVICE=nova-local-notes-memory-service
NOVA_PG_PASSWORD_NOTIFICATION_SERVICE=nova-local-notification-service
NOVA_PG_PASSWORD_POLICY_APPROVAL_SERVICE=nova-local-policy-approval-service
NOVA_PG_PASSWORD_TASKS_REMINDERS_SERVICE=nova-local-tasks-reminders-service
NOVA_PG_PASSWORD_TRIPS_SERVICE=nova-local-trips-service
