{
  "family": "calendar_tasks",
  "operations": [
    {
      "operation_id": "calendar_tasks.read",
      "name": "calendar_tasks.read",
      "description": "Read calendar events and tasks",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "start",
            "end"
          ]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array"
            },
            "tasks": {
              "type": "array"
            }
          },
          "required": []
        }
      },
      "classification": "read",
      "risk_tier": "tier1",
      "idempotency": "none",
      "verifier": "verify_calendar_tasks_read",
      "family": "calendar_tasks",
      "owning_service": "calendar-service",
      "mcp_server": "calendar-mcp",
      "resource_scope": "own_events_tasks",
      "allowed_roles": [
        "user"
      ],
      "allowed_scopes": [
        "calendar_tasks:read"
      ],
      "version": 1
    },
