/**
 * Nova design system - Tasks note tool family catalogue.
 * Registers note-related tools: create, search, read, link, summarise.
 * Each operation carries classification, risk_tier, idempotency, verifier,
 * owning_service, mcp_server, resource_scope, allowed_roles, allowed_scopes,
 * version.
 */

{
  "family": "tasks",
  "operations": [
    {
      "operation_id": "tasks.note.create",
      "name": "tasks.note.create",
      "description": "Create a new note.",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "content": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "source_type": { "type": "string" },
            "source_ref": { "type": "string" }
          },
          "required": ["title", "content"]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "note_id": { "type": "string" }
          },
          "required": ["note_id"]
        }
      },
      "classification": "write",
      "risk_tier": "tier1",
      "idempotency": "none",
      "verifier": "verify_note_create",
      "family": "tasks",
      "owning_service": "tasks-reminders-service",
      "mcp_server": "tasks-mcp",
      "resource_scope": "own_notes",
      "allowed_roles": ["user"],
      "allowed_scopes": ["notes:write"],
      "version": 1
    },
    {
      "operation_id": "tasks.note.search",
      "name": "tasks.note.search",
      "description": "Search notes by full-text content.",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "limit": { "type": "integer" }
          },
          "required": ["query"]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "notes": { "type": "array" }
          },
          "required": ["notes"]
        }
      },
      "classification": "read",
      "risk_tier": "tier1",
      "idempotency": "none",
      "verifier": "verify_note_search",
      "family": "tasks",
      "owning_service": "tasks-reminders-service",
      "mcp_server": "tasks-mcp",
      "resource_scope": "own_notes",
      "allowed_roles": ["user"],
      "allowed_scopes": ["notes:read"],
      "version": 1
    },
    {
      "operation_id": "tasks.note.read",
      "name": "tasks.note.read",
      "description": "Read a note by ID.",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "note_id": { "type": "string" }
          },
          "required": ["note_id"]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "note": { "type": "object" }
          },
          "required": ["note"]
        }
      },
      "classification": "read",
      "risk_tier": "tier1",
      "idempotency": "none",
      "verifier": "verify_note_read",
      "family": "tasks",
      "owning_service": "tasks-reminders-service",
      "mcp_server": "tasks-mcp",
      "resource_scope": "own_notes",
      "allowed_roles": ["user"],
      "allowed_scopes": ["notes:read"],
      "version": 1
    },
    {
      "operation_id": "tasks.note.link",
      "name": "tasks.note.link",
      "description": "Link two notes together.",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "note_id": { "type": "string" },
            "linked_note_id": { "type": "string" },
            "link_type": { "type": "string" }
          },
          "required": ["note_id", "linked_note_id"]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "link_id": { "type": "string" }
          },
          "required": ["link_id"]
        }
      },
      "classification": "write",
      "risk_tier": "tier1",
      "idempotency": "idempotency_key",
      "verifier": "verify_note_link",
      "family": "tasks",
      "owning_service": "tasks-reminders-service",
      "mcp_server": "tasks-mcp",
      "resource_scope": "own_notes",
      "allowed_roles": ["user"],
      "allowed_scopes": ["notes:write"],
      "version": 1
    },
    {
      "operation_id": "tasks.note.summarise",
      "name": "tasks.note.summarise",
      "description": "Summarise a note's content.",
      "arguments": {
        "schema": {
          "type": "object",
          "properties": {
            "note_id": { "type": "string" },
            "max_length": { "type": "integer" }
          },
          "required": ["note_id"]
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" }
          },
          "required": ["summary"]
        }
      },
      "classification": "read",
      "risk_tier": "tier1",
      "idempotency": "none",
      "verifier": "verify_note_summarise",
      "family": "tasks",
      "owning_service": "tasks-reminders-service",
      "mcp_server": "tasks-mcp",
      "resource_scope": "own_notes",
      "allowed_roles": ["user"],
      "allowed_scopes": ["notes:read"],
      "version": 1
    }
  ],
  "version": 1
}
