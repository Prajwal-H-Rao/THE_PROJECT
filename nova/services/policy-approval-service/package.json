{
  "name": "@nova/policy-approval-service",
  "version": "0.1.0",
  "private": true,
  "description": "Policy and approval engine for NOVA",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "build": "nest build && cp -r src/policy/families dist/policy/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run build && node --test dist/**/*.test.js",
    "test:watch": "node --watch --test dist/**/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nova/contracts": "file:../../packages/contracts",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^4.24.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
